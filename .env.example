# Only used in stdio mode (no $PORT) -- in HTTP mode, each caller brings
# their own Zotero Library ID/Type/API Key via the /login form instead
# (see app/oauth_provider.py).
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_KEY=
# ZOTERO_APP_KEY= also works as an alias -- that's the label on Zotero's
# own key-creation page (Settings -> Security -> Applications).

# Only needed when serving over HTTP ($PORT set).
# Fernet key encrypting onboarded tenants' Zotero API keys at rest.
# Generate once at deploy time with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_TOKEN_STORE_KEY=
# Public HTTPS URL this server is reachable at (OAuth issuer/resource URL).
MCP_PUBLIC_URL=
# Where registered OAuth clients/tokens/tenants are persisted (default: ./.data).
MCP_DATA_DIR=
# Optional. Public site to report as serverInfo.website_url; if set, also
# used to build serverInfo.icons[0].src as MCP_WEBSITE_URL + "icons/icon.svg"
# (the icon must actually be served there, e.g. via docs/icons/icon.svg on
# GitHub Pages). Left unset, both fields are simply omitted.
MCP_WEBSITE_URL=
