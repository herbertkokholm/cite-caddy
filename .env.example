ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_KEY=
# ZOTERO_APP_KEY= also works as an alias -- that's the label on Zotero's
# own key-creation page (Settings -> Security -> Applications).

# Only needed when serving over HTTP ($PORT set) -- gates this server's own
# OAuth login form (see app/oauth_provider.py), not the Zotero API.
MCP_AUTH_USERNAME=
MCP_AUTH_PASSWORD=
# Public HTTPS URL this server is reachable at (OAuth issuer/resource URL).
MCP_PUBLIC_URL=
# Where registered OAuth clients/tokens are persisted (default: ./.data).
MCP_DATA_DIR=
